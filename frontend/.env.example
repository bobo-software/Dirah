# Plain `npm run dev` reads this file. `npm run dev:sec` loads Infisical `dev` instead.
# Leave VITE_API_URL unset to call this origin: the Vite dev server proxies /api to
# http://localhost:4006 (vite.config.ts) and nginx does the same in production.
# Set it only when the API runs on another origin.
# VITE_API_URL=http://localhost:4002

# API origin shown to users and called by outside clients (MCP connectors, mobile).
# A deployed build needs this. Local dev falls back to http://localhost:4006.
# VITE_PUBLIC_API_URL=https://api.dirah.co.za
