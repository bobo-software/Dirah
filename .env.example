# Plain `npm run dev` reads this file. `npm run dev:sec` also loads the Infisical `dev`
# environment (see INFISICAL.md). When NODE_ENV=development, the API uses DB_LOCAL_*
# below and SSL stays off. The Postgres MCP can still query the remote database
# (DB_* / DB_SSL / DB_SSL_CA) by passing target "live".
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5181
# Public origin used in invite links. Defaults to CORS_ORIGIN when that is a single URL.
APP_PUBLIC_URL=http://localhost:5181
# Optional SMTP. Leave SMTP_HOST empty to skip sending mail and return a copyable inviteUrl instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Production refuses to boot unless both secrets are unique and at least 32 characters.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Bootstraps a system admin when system_admins is empty. Leave empty to skip.
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=

BLOB_DIR=uploads

# Optional copilot (OpenAI-compatible). Leave empty to disable; editing still works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini


# Remote Postgres. The deployed API uses this. In development the Postgres MCP
# reaches it with target "live".
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dirah
DB_PASSWORD=dirah
DB_DATABASE=dirah
# Postgres TLS for the remote database. Use verify-full when the server certificate
# is privately signed. DB_SSL_CA is the CA PEM, including the BEGIN/END lines.
# A file path is also accepted. Infisical holds the PEM for dev and prod.
DB_SSL=disable
# DB_SSL_CA=

# Local Postgres used by the API when NODE_ENV=development, and by MCP target "local".
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=5432
DB_LOCAL_USERNAME=postgres
DB_LOCAL_DATABASE=dirah
DB_LOCAL_PASSWORD=

# Per-IP limits. Login, register, and invite accept use the login window. Refresh and logout use the refresh window.
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_LOGIN_RATE_WINDOW_MS=900000
# AUTH_REFRESH_RATE_LIMIT=120
# AUTH_REFRESH_RATE_WINDOW_MS=60000

MCP_API_KEY=dev-mcp-key-change-in-production
MCP_PG_POOL_LIMIT=10
MCP_PG_DEFAULT_SELECT_LIMIT=100
MCP_PG_MAX_SELECT_LIMIT=1000
MCP_PG_MAX_WRITE_LIMIT=1000
MCP_PG_QUERY_TIMEOUT_MS=15000
MCP_PG_MIGRATION_TIMEOUT_MS=300000
MCP_PG_MAX_BULK_INSERT_ROWS=5000
MCP_DOCS_RATE_LIMIT=120
MCP_DOCS_RATE_WINDOW_MS=60000

# Optional S3-compatible blobs (MinIO). Leave MINIO_ENDPOINT empty to use BLOB_DIR on disk.
# Production refuses to boot if this is set and is not https://.
# The API talks to MINIO_ENDPOINT; MINIO_SERVER_URL / MINIO_BROWSER_REDIRECT_URL are for the MinIO console.
# docker compose minio is http://localhost:9000 (console :9001); set keys to match that service if you use it.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=dirah
MINIO_REGION=us-east-1
MINIO_SERVER_URL=
MINIO_BROWSER_REDIRECT_URL=

# Optional Google / GitHub sign-in. Leave empty to hide the buttons; password login still works.
# Callbacks: {API_PUBLIC_URL}/api/auth/oauth/google/callback and .../github/callback
API_PUBLIC_URL=http://localhost:4006
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=