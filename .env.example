# One env file for the monorepo. Copy to `.env` at the repo root; it is
# gitignored. Both workspaces read it (`backend/src/config/env.ts` and Vite's
# `envDir`), and docker-compose.prod.yml passes it to the API container.
#
# The API and the web build share this file, but only VITE_* values reach the
# browser bundle. Never put a secret behind a VITE_ prefix.
#
# Local `npm run dev` uses this file. The hosted Coolify application gets the
# same keys from its environment (Coolify writes them to `.env` next to the
# compose file). A self-hosted Docker install uses `.env.selfhost.example`.

# --- API ---
# The API listens here. Root nginx proxies to backend:4006, so production uses
# 4006 too. A local `.env` may use another port; point VITE_API_URL at it.
PORT=4006
NODE_ENV=development
# Self-hosted installs over plain HTTP (localhost/LAN) only. Production rejects
# http:// origins and http:// MINIO_ENDPOINT unless this is true. Leave false
# for the hosted install and for anything behind TLS.
ALLOW_INSECURE_HTTP=false
CORS_ORIGIN=http://localhost:5181
# Public origin used in invite links. Defaults to CORS_ORIGIN when that is a single URL.
APP_PUBLIC_URL=http://localhost:5181
# Production only: the bare domain the web and API share, e.g. dirah.co.za.
# Required when APP_PUBLIC_URL and API_PUBLIC_URL are on different hosts, so the
# OAuth callback can set a refresh cookie the web origin will send. Leave empty
# for a single-host (self-hosted) install. Use dirah.co.za for the hosted install.
SESSION_COOKIE_DOMAIN=

# Production refuses to boot unless both secrets are unique and at least 32 characters.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Bootstraps a system admin when system_admins is empty. Leave empty to skip.
# Bootstrap only: use a password without $ or ' — Compose interpolates them in
# .env values. Once the admin exists, leave both empty.
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=

BLOB_DIR=uploads

# --- Database ---
# Used by the API, Drizzle, migrations, MCP, and the Coolify deployment.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dirah
DB_PASSWORD=dirah
DB_DATABASE=dirah
# Postgres TLS. Use verify-full when the server certificate is privately signed.
# DB_SSL_CA is the CA PEM, including the BEGIN/END lines. A file path is also
# accepted. Quote a multi-line PEM and escape each newline as \n.
DB_SSL=disable
# DB_SSL_CA=

# --- Mail (optional) ---
# Leave SMTP_HOST empty to skip sending mail and return a copyable inviteUrl instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- Object storage (optional) ---
# Leave MINIO_ENDPOINT empty to use BLOB_DIR on disk.
# Production refuses to boot if this is set and is not https://.
# The API talks to MINIO_ENDPOINT; MINIO_SERVER_URL / MINIO_BROWSER_REDIRECT_URL are for the MinIO console.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=dirah
MINIO_REGION=us-east-1
MINIO_SERVER_URL=
MINIO_BROWSER_REDIRECT_URL=

# --- OAuth (optional) ---
# Leave empty to hide the buttons; password login still works.
# Callbacks: {API_PUBLIC_URL}/api/auth/oauth/google/callback and .../github/callback
API_PUBLIC_URL=http://localhost:4006
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Copilot (optional) ---
# OpenAI-compatible. Leave AI_API_KEY empty to disable; editing still works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- MCP ---
MCP_API_KEY=dev-mcp-key-change-in-production
MCP_PG_POOL_LIMIT=10
MCP_PG_DEFAULT_SELECT_LIMIT=100
MCP_PG_MAX_SELECT_LIMIT=1000
MCP_PG_MAX_WRITE_LIMIT=1000
MCP_PG_QUERY_TIMEOUT_MS=15000
MCP_PG_MIGRATION_TIMEOUT_MS=300000
MCP_PG_MAX_BULK_INSERT_ROWS=5000
MCP_DOCS_RATE_LIMIT=120
MCP_DOCS_RATE_WINDOW_MS=60000

# Per-IP limits. Login, register, and invite accept use the login window.
# Refresh and logout use the refresh window.
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_LOGIN_RATE_WINDOW_MS=900000
# AUTH_REFRESH_RATE_LIMIT=120
# AUTH_REFRESH_RATE_WINDOW_MS=60000

# --- Web build ---
# The browser calls its own origin: Vite proxies /api in development and nginx
# proxies it in production. Leave VITE_API_URL unset unless the API is on
# another origin (a local API on a non-4006 port, for example).
# VITE_API_URL=http://localhost:4002

# The API origin shown to users and called by MCP clients. The hosted build sets
# it explicitly (docker-compose.prod.yml requires it). A same-origin self-host
# install can leave it unset: the client uses the page origin at runtime.
# VITE_PUBLIC_API_URL=https://api.dirah.co.za
