# Self-hosted install. Copy to `.env` next to docker-compose.selfhost.yml:
#
#   cp .env.selfhost.example .env
#
# Postgres and MinIO/S3 are external: this file points at services you run or
# a managed provider. The compose file starts only the API, the web app and a
# one-shot migration service.
#
# Generate the secrets before first boot:
#   openssl rand -hex 32   # JWT_SECRET
#   openssl rand -hex 32   # JWT_REFRESH_SECRET
#   openssl rand -hex 24   # MCP_API_KEY
#
# Avoid `$` and `'` in values that Compose reads from this file (notably
# SYSTEM_ADMIN_PASSWORD); Compose interpolates them. Bootstrap only.

# --- Install ---
WEB_PORT=8080
NODE_ENV=production
PORT=4006

# --- Public URLs ---
# For a local/LAN install over plain HTTP, set all three to the same origin and
# keep ALLOW_INSECURE_HTTP=true. Behind a TLS reverse proxy, use https:// and
# set ALLOW_INSECURE_HTTP=false.
APP_PUBLIC_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
# Only needed when the web and API hosts differ; leave empty for one host.
SESSION_COOKIE_DOMAIN=

# Allows http:// origins and an http:// MINIO_ENDPOINT. Never enable this for a
# public install without TLS in front.
ALLOW_INSECURE_HTTP=true

# --- Secrets ---
# Production refuses to boot with these placeholders or anything under 32 chars.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
MCP_API_KEY=change-me

# Bootstraps the first system admin when system_admins is empty. Once the admin
# exists, leave both empty.
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=change-me-now

# --- Database (external) ---
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_USERNAME=dirah
DB_PASSWORD=change-me
DB_DATABASE=dirah
# Use verify-full for a TLS database; put the CA PEM in DB_SSL_CA (quote it and
# escape newlines as \n), or point DB_SSL_CA at a readable file path.
DB_SSL=disable
# DB_SSL_CA=

# --- Object storage (external MinIO/S3) ---
# Required for this bundle. Leave MINIO_ENDPOINT empty only if you accept blob
# data in the container's filesystem (it disappears when the container is
# recreated); in that case mount a volume for BLOB_DIR.
MINIO_ENDPOINT=https://minio.example.com
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=dirah
MINIO_REGION=us-east-1
# For a private MinIO over plain HTTP with ALLOW_INSECURE_HTTP=true:
# MINIO_ENDPOINT=http://minio.example.internal:9000

# --- Mail (optional) ---
# Leave SMTP_HOST empty to skip sending mail and return a copyable invite URL.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- OAuth (optional) ---
# Callbacks: {API_PUBLIC_URL}/api/auth/oauth/google/callback and .../github/callback
# Google requires https for a non-localhost callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Copilot (optional) ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Web build ---
# Leave empty for a same-origin install: the browser calls its own origin and
# nginx proxies /api, /mcp and the OAuth discovery paths to the API.
# VITE_PUBLIC_API_URL=https://api.example.com
# VITE_API_URL is only for an API on another origin; leave it unset.
